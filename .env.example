# ServiceFlow — Environment Variable Reference
#
# Copy this file to `.env` in the same folder it's needed (see notes below)
# and fill in REAL values there. Never commit `.env` — it's gitignored.
# Every value below is a DEVELOPMENT PLACEHOLDER, not a real credential.

# ─────────────────────────────────────────────────────────────────────────
# server/.env  (backend — Express app / Netlify Function)
# ─────────────────────────────────────────────────────────────────────────

# Supabase Postgres connection string (transaction pooler, port 6543 preferred
# for serverless; session pooler on 5432 also works). Get from:
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@REPLACE_ME.pooler.supabase.com:6543/postgres

# Clerk secret key — used server-side ONLY to verify session tokens.
# Get from: Clerk Dashboard → API Keys → Secret key
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk publishable key is also needed server-side for some SDK calls.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# OpenRouter API key — used server-side ONLY by the AI Service Assistant
# (Phase 6). Never expose this to the frontend. Get from: openrouter.ai/keys
# Leave as REPLACE_ME to run without it — the assistant degrades gracefully
# (see README "AI Service Assistant") and the core app works either way.
OPENROUTER_API_KEY=REPLACE_ME

# Optional: which OpenRouter model to use. Defaults to openai/gpt-4o-mini
# in code if unset — only set this if you want a different model.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Supabase project URL + service_role key — used server-side ONLY to
# broadcast realtime signals (Phase 7). The service_role key bypasses all
# database security; never expose it to the frontend. Leave both as
# REPLACE_ME to run without realtime — it degrades to each query's normal
# polling (see README "Realtime updates"). Get from: Supabase Dashboard →
# Project Settings → API (same project as DATABASE_URL above).
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Port for local Express dev server (Netlify Functions ignore this in prod)
PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# client/.env  (frontend — Vite; only VITE_-prefixed vars reach the browser)
# ─────────────────────────────────────────────────────────────────────────

# Base URL the frontend calls for the REST API.
# Local dev: the local Express server. Production: /api (proxied by Netlify).
VITE_API_URL=http://localhost:4000/api

# Clerk publishable key — safe for the browser (public by design).
# Get from: Clerk Dashboard → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Supabase project URL + anon key — used ONLY for Supabase Realtime
# subscriptions from the browser (Phase 7). The anon key is safe for the
# browser by design; safety here comes from realtime payloads carrying no
# data (see README "Realtime updates"), not from Postgres RLS — we don't
# use Supabase Auth, so RLS's auth.uid() has nothing to check against.
# Leave both as REPLACE_ME to run without realtime.
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME
